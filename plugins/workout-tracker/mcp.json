{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "workout-tracker": {
      "type": "streamable-http",
      "url": "https://workout.lbyte.app/mcp/public"
    },
    "workout-tracker-account": {
      "type": "streamable-http",
      "url": "https://workout.lbyte.app/mcp/account",
      "headers": {
        "Authorization": "Bearer ${WORKOUT_TRACKER_TOKEN}"
      }
    }
  }
}
